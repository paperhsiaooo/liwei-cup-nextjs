### 狀態管理

#### 1. Zustand Store 模式

```js
// store/example-context.js
import { create } from 'zustand'
import { persist, createJSONStorage } from 'zustand/middleware'

const useExampleStore = create(
  persist(
    (set, get) => ({
      data: [],
      addData: item =>
        set(state => ({
          data: [...state.data, item],
        })),
      getData: () => get().data,
    }),
    {
      name: 'liwei-example',
      storage: createJSONStorage(() =>
        typeof window === 'undefined'
          ? { getItem: () => null, setItem: () => {}, removeItem: () => {} }
          : window.localStorage,
      ),
    },
  ),
)
```

#### 2. React Query Hooks

```js
// apis/hook/use-example.js
import { useMutation, useQuery } from '@tanstack/react-query'
import { axs } from '@/utils/axios'

async function fetchDataAPI(params) {
  const data = await axs('/endpoint', params)
  return data
}

function useFetchData(options) {
  return useQuery({
    queryKey: ['example', 'fetchData'],
    queryFn: () => fetchDataAPI(options),
  })
}

function useSubmitData(onSuccess) {
  return useMutation({
    mutationKey: ['example', 'submitData'],
    mutationFn: payload => submitDataAPI(payload),
    onSuccess: data => {
      onSuccess(data)
    },
  })
}
```

### 表單處理

#### 1. React Hook Form + Zod

```jsx
// schema/example-schema.js
import { z } from 'zod'

export const exampleSchema = z.object({
  name: z.string().min(1, '請輸入名稱'),
  email: z.string().email('請輸入有效的電子郵件'),
})

// component
import { useForm } from 'react-hook-form'
import { zodResolver } from '@hookform/resolvers/zod'
import FormProvider from '@/components/common/hook-form/form-provider'
import RHFTextField from '@/components/common/hook-form/rhf-text-field'

function ExampleForm() {
  const methods = useForm({
    resolver: zodResolver(exampleSchema),
    defaultValues: { name: '', email: '' },
  })

  const onSubmit = data => {
    console.log(data)
  }

  return (
    <FormProvider methods={methods} onSubmit={methods.handleSubmit(onSubmit)}>
      <RHFTextField name="name" placeholder="姓名" />
      <RHFTextField name="email" type="email" placeholder="電子郵件" />
      <button type="submit">提交</button>
    </FormProvider>
  )
}
```

